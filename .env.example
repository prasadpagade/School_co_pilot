# ─────────────────────────────────────────────
# Google API Configuration
# ─────────────────────────────────────────────
GOOGLE_API_KEY=your-gemini-api-key          # Get from https://aistudio.google.com/app/apikey
FILE_SEARCH_STORE_NAME=                     # Set after running: python -m scripts.init_file_search_store

# ─────────────────────────────────────────────
# Gmail Configuration
# ─────────────────────────────────────────────
SCHOOL_DOMAINS=@yourschool.org              # Comma-separated email domains to ingest
SCHOOL_SENDERS=teacher@school.org           # Comma-separated specific sender emails
GMAIL_CLIENT_ID=xxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=xxxxxxx
GMAIL_REDIRECT_URI=http://localhost

# ─────────────────────────────────────────────
# Calendar Configuration
# ─────────────────────────────────────────────
CALENDAR_ID=primary
DEFAULT_CALENDAR_ATTENDEES=spouse@example.com
EMAIL_INGESTION_TIME=18:00                  # Daily ingestion time (24-hour format)

# ─────────────────────────────────────────────
# Personalization (shown in UI and AI prompts)
# ─────────────────────────────────────────────
CHILD_NAME=your child                       # e.g. "Emma"
SCHOOL_NAME=school                          # e.g. "Lincoln Elementary"
APP_TITLE=School Copilot                    # Shown in browser tab and header

# ─────────────────────────────────────────────
# Notifications (Phase 1)
# Get a free Resend API key at https://resend.com (3,000 emails/month free)
# ─────────────────────────────────────────────
PARENT_EMAIL=                               # Your email — where to send new-email alerts
RESEND_API_KEY=                             # From https://resend.com/api-keys
NOTIFICATION_FROM_EMAIL=notifications@resend.dev  # Use resend.dev domain on free tier

# ─────────────────────────────────────────────
# Error Tracking (Phase 1)
# Get a free Sentry DSN at https://sentry.io (5,000 errors/month free)
# ─────────────────────────────────────────────
SENTRY_DSN=                                 # From https://sentry.io — leave blank to disable

# ─────────────────────────────────────────────
# Auth — Google OAuth App (Phase 2)
# One set of credentials for ALL users (standard web app pattern)
# Create at https://console.cloud.google.com/apis/credentials (Web application type)
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=                           # OAuth 2.0 client ID
GOOGLE_CLIENT_SECRET=                       # OAuth 2.0 client secret
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
JWT_SECRET=change-this-to-a-random-64-char-string

# ─────────────────────────────────────────────
# Stripe Payments (Phase 3)
# Get keys at https://dashboard.stripe.com/apikeys
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=                          # sk_test_... (test) or sk_live_... (prod)
STRIPE_PUBLISHABLE_KEY=                     # pk_test_... (test) or pk_live_... (prod)
STRIPE_WEBHOOK_SECRET=                      # From Stripe webhook dashboard (whsec_...)
STRIPE_PRO_PRICE_ID=                        # Price ID for Parent Pro plan
STRIPE_FAMILY_PRICE_ID=                     # Price ID for Family plan

# ─────────────────────────────────────────────
# Environment
# ─────────────────────────────────────────────
ENVIRONMENT=development                     # "development" or "production"
CORS_ORIGINS=*                              # In production: https://your-app.onrender.com
